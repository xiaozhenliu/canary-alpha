<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.canary-alpha-mcp</string>

    <key>ProgramArguments</key>
    <array>
      <string>__NODE_BINARY__</string>
      <string>__PROJECT_ROOT__/dist/src/index.js</string>
      <string>--mode</string>
      <string>http</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
__ENVIRONMENT_VARIABLES__
    </dict>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__LAUNCHD_STDOUT_PATH__</string>

    <key>StandardErrorPath</key>
    <string>__LAUNCHD_STDERR_PATH__</string>
  </dict>
</plist>
